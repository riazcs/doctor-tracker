# Port the API listens on
PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# Secret used to sign session JWTs (min 32 chars). Must match frontend JWT_SECRET.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Session lifetime (jose duration string, e.g. 8h, 1d)
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call the API directly
CORS_ORIGIN=http://localhost:3000
