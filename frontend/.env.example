# URL of the Express API (server-side only; the browser calls /api on this origin)
BACKEND_URL=http://localhost:4000

# Must match the backend JWT_SECRET. Used by src/proxy.ts to verify the session
# cookie before rendering protected pages (fast redirect to /login when invalid).
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
